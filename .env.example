# --- Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (Django chạy trên máy => host là localhost) ---
DB_NAME=epwms_db
DB_USER=epwms_user
DB_PASSWORD=epwms_dev_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Django chạy trên máy => localhost) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS: địa chỉ frontend được phép gọi API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
