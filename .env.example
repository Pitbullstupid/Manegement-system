# --- Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (Django chạy trên máy => host là localhost) ---
DB_NAME=epwms_db
DB_USER=epwms_user
DB_PASSWORD=epwms_dev_password
DB_HOST=localhost
DB_PORT=5433

# --- Redis (Django chạy trên máy => localhost) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS: địa chỉ frontend được phép gọi API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Mailpit (dev): cổng phía máy bạn. Nếu đổi, EMAIL_PORT bên dưới phải đổi theo ---
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Email (Django chạy trên máy => EMAIL_HOST=localhost; Phase 7A đổi thành mailpit) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Project Workflow <no-reply@localhost>

# --- Frontend: dùng để tạo link trong email ---
FRONTEND_URL=http://localhost:5173

# --- OTP: hết hạn (giây), số lần nhập sai tối đa, thời gian chờ giữa 2 lần gửi (giây) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
